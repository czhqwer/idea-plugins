<idea-plugin>
    <id>dev.czh.idea.devdock</id>
    <name>DevDock</name>
    <icon>/icons/devdock.svg</icon>
    <vendor email="">czh</vendor>
    <description><![CDATA[
        <p>面向日常开发的原生 IntelliJ IDEA 工具箱，集中处理编码、转换、校验与调试任务。</p>
        <p>支持 IntelliJ IDEA 2024.1 及以上版本，Windows 与 macOS 共用同一插件包。</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="DevDock" anchor="right" factoryClass="dev.czh.idea.ctool.ui.DevDockToolWindowFactory" />
    </extensions>

    <actions>
        <action id="dev.czh.idea.devdock.open" class="dev.czh.idea.ctool.action.OpenDevDockAction"
                text="DevDock" description="打开 DevDock 开发工具箱">
            <add-to-group group-id="ToolsMenu" anchor="last" />
        </action>
    </actions>
</idea-plugin>
